  "textes": {
    "ouverture": [
      "Mesdames, messieurs, je suis Gaspard, majordome de cette maison depuis trente et un ans.",
      "Ce soir, pendant que l'orage frappait les vitres, Lord Edmond de Valmont a été retrouvé sans vie.",
      "Les portes sont closes, la route est inondée. Personne n'est entré, personne n'est sorti.",
      "L'assassin est donc parmi vous. Il porte un habit de soirée et sourit comme vous.",
      "Je répondrai à vos questions avec exactitude. Un majordome ne ment jamais. Les couloirs, eux, chuchotent."
    ],
    "fin": "Gaspard s'éclaircit la voix. « C'est {tueur} qui a tué Lord Edmond, dans {lieu}, avec {arme}. » {verdict}",
    "verdict_enqueteurs": "{detective} a percé le mystère avant l'aube. Le manoir peut enfin dormir.",
    "verdict_tueur": "L'aube s'est levée sans qu'on démasque {tueur}. Les invités repartent, l'assassin avec eux.",
    "indices": {
      "suspect": [
        "Gaspard certifie que {nom} n'a pas quitté le salon de la soirée.",
        "Gaspard a servi {nom} toute la soirée : {nom} n'a pas pu frapper.",
        "Gaspard se porte garant de {nom}, vu à chaque coup de l'horloge."
      ],
      "arme": [
        "Gaspard a vérifié {arme} : l'objet n'a pas bougé de sa place.",
        "Gaspard assure que {arme} n'a servi à personne ce soir.",
        "Gaspard a retrouvé {arme} intact, couvert de la poussière d'hier."
      ],
      "lieu": [
        "Gaspard certifie que {lieu} n'a vu personne de la soirée.",
        "Gaspard a fermé {lieu} à clé avant le dîner : personne n'y est entré.",
        "Gaspard a inspecté {lieu} : pas une trace, pas un bruit."
      ]
    },
    "rumeurs": {
      "suspect": [
        "On chuchote que {nom} avait une dette envers Lord Edmond.",
        "Quelqu'un a vu {nom} rôder près des escaliers.",
        "On murmure que {nom} a changé de veste pendant la soirée."
      ],
      "arme": [
        "On dit que {arme} n'était plus à sa place après le dîner.",
        "Une invitée jure avoir vu quelqu'un manier {arme}.",
        "On chuchote que {arme} a été essuyé en hâte."
      ],
      "lieu": [
        "On a entendu un cri du côté de {lieu}.",
        "Une bougie brûlait encore dans {lieu} bien après minuit.",
        "On dit que la porte de {lieu} grinçait pendant l'orage."
      ]
    },
    "annonces": {
      "indice": "Gaspard remet discrètement un pli à l'un d'entre vous.",
      "accusation_ratee": "Une accusation a échoué. Gaspard hausse un sourcil.",
      "interference": "Gaspard a remarqué une interférence dans le courrier de la maison.",
      "dossier_epuise": "Gaspard n'a plus rien à révéler : le dossier est épuisé.",
      "fin": "L'enquête est close."
    },
    "evenements": {
      "coupure": {
        "nom": "L'orage fait sauter le courant",
        "debut": "Un éclair, puis le noir. Le courrier attendra la lumière.",
        "fin": "Le courant revient. Gaspard rallume les chandelles."
      },
      "decouverte": {
        "nom": "Gaspard a trouvé quelque chose",
        "debut": "Gaspard revient de sa ronde, l'air grave.",
        "fin": ""
      },
      "alerte": {
        "nom": "L'inspecteur presse l'enquête",
